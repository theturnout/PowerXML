    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PowerShell: Debug Pester Tests",
            "type": "PowerShell",
            "request": "launch",
            "script": "Invoke-Pester",
            "args": [
                "-Script",
                "${workspaceFolder}/powerxml.tests.ps1",
                "-Output",
                "Detailed"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Clean PowerShell: Debug Pester Tests",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/test-harness.ps1",
            "args": [
                "-NoCache"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}